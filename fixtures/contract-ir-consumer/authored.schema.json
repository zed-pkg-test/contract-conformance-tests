{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zed-sibling-admission-test.schema.json",
  "$defs": {
    "PackageInstallIntent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "PackageInstallIntent",
      "type": "object",
      "properties": {
        "package": { "type": "string" },
        "version": { "type": "string" },
        "dryRun": { "type": "boolean" }
      },
      "required": ["package", "version", "dryRun"],
      "unevaluatedProperties": false
    }
  }
}
