+fn validate_resolved_source(source: &ResolvedDeploymentSource) -> Result<(), PolicyError> {
+    if source.members.is_empty() {
+        return Err(PolicyError::EmptyResolvedSource);
+    }
+
+    if !is_sha256(&source.compose_sha256) {
+        return Err(PolicyError::InvalidSha256("source.compose_sha256".to_string()));
+    }
+
+    if !is_sha256(&source.admission_sha256) {
+        return Err(PolicyError::InvalidSha256("source.admission_sha256".to_string()));
+    }
+
+    for member in &source.members {
+        if member.locator.trim().is_empty() {
+            return Err(PolicyError::EmptySourceLocator);
+        }
+
+        if is_mutable_revision(&member.revision) {
+            return Err(PolicyError::MutableResolvedRevision(member.locator.clone()));
+        }
+
+        if !is_sha256(&member.content_sha256) {
+            return Err(PolicyError::InvalidSha256(format!(
+                "source member {} content_sha256",
+                member.locator
+            )));
+        }
     }
 
     return Ok(());
 }
 
+fn is_mutable_revision(revision: &str) -> bool {
+    let normalized = revision.trim().to_ascii_lowercase();
+
+    if normalized.is_empty() {
+        return true;
+    }
+
+    return matches!(
+        normalized.as_str(),
+        "latest" | "main" | "master" | "head" | "trunk" | "dev" | "develop" | "development"
+    );
+}
+
+fn is_git_object_id(revision: &str) -> bool {
+    let revision = revision.trim();
+
+    if revision.len() != 40 && revision.len() != 64 {
+        return false;
+    }
+
+    return revision.bytes().all(|byte| byte.is_ascii_hexdigit());
+}
+
+fn is_sha256(value: &str) -> bool {
+    let value = value.strip_prefix("sha256:").unwrap_or(value);
+
+    if value.len() != 64 {
+        return false;
+    }
+
+    return value.bytes().all(|byte| byte.is_ascii_hexdigit());
+}
