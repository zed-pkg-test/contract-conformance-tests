+fn run_deployment_stage<A, F>(
+    adapter: &A,
+    plan: &DeploymentPlan,
+    stage: DeploymentStage,
+    operation: F,
+) -> Result<(), PolicyError>
+where
+    A: ProductDeploymentAdapter,
+    F: FnOnce(&A, &DeploymentPlan) -> Result<(), String>,
+{
+    if let Err(message) = operation(adapter, plan) {
+        let rollback_error = adapter
+            .rollback_deployment(plan, &stage)
+            .err();
+
+        return Err(PolicyError::DeploymentStageFailed {
+            stage,
+            message,
+            rollback_error,
+        });
+    }
+
+    return Ok(());
+}
