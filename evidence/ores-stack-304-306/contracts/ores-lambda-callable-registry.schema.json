{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oresoftware.dev/schemas/ores-lambda-callable-registry-v1.schema.json",
  "title": "ORE Lambda callable registry",
  "$comment": "Authored independently from TypeSpec. Rust validation owns cross-field binding between callable identity, transport ABI identity and current filesystem locator. Source-leaf origin is provenance, not transport: a REST leaf may project through REST and generated RPC without changing callable identity. Source paths locate current leaves but never participate in callable_id derivation.",
  "$defs": {
    "callable_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "callable_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+_a[0-9]+_[0-9a-f]{20}$"
    },
    "authority_source": {
      "type": "string",
      "pattern": "^src/(routes/rest/.+/handlers|rpc/.+/funcs|graphql/.+/resolver)\\.rs$"
    },
    "lambda_source": {
      "type": "string",
      "pattern": "^src/(routes/rest|rpc|graphql)/.+/lambda\\.rs$"
    },
    "leaf_identity": {
      "type": "string",
      "pattern": "^(rest_leaf:src/routes/rest/|rpc_leaf:src/rpc/|graphql_leaf:src/graphql/).+$"
    },
    "callable_origin_kind": {
      "enum": ["rest_leaf", "rpc_leaf", "graphql_leaf"]
    },
    "transport_leaf_kind": {
      "enum": ["rest", "rpc", "graphql"]
    },
    "transport_leaf_stream_mode": {
      "enum": ["unary", "server_stream"]
    },
    "graphql_leaf_kind": {
      "enum": ["query", "mutation", "subscription"]
    },
    "callable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "callable_name", "arity", "callable_id"],
      "properties": {
        "schema_version": { "const": "ores.lambda.callable-id.v1" },
        "callable_name": { "$ref": "#/$defs/callable_name" },
        "arity": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "callable_id": { "$ref": "#/$defs/callable_id" }
      }
    },
    "transport_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "abi_version",
        "transport",
        "operation_key",
        "callable_id",
        "projection_id",
        "stream_mode"
      ],
      "properties": {
        "schema": { "const": "ores.api-docs.transport-leaf-build-identity.v1" },
        "abi_version": { "const": "ores.api-docs.transport-leaf-abi.v1" },
        "transport": { "$ref": "#/$defs/transport_leaf_kind" },
        "operation_key": { "$ref": "#/$defs/callable_name" },
        "callable_id": { "$ref": "#/$defs/callable_id" },
        "projection_id": { "type": "string", "minLength": 1 },
        "stream_mode": { "$ref": "#/$defs/transport_leaf_stream_mode" },
        "graphql_kind": { "$ref": "#/$defs/graphql_leaf_kind" },
        "capabilities": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_kind",
        "leaf_identity",
        "authority_source",
        "lambda_source",
        "transport_identity"
      ],
      "properties": {
        "origin_kind": { "$ref": "#/$defs/callable_origin_kind" },
        "leaf_identity": { "$ref": "#/$defs/leaf_identity" },
        "authority_source": { "$ref": "#/$defs/authority_source" },
        "lambda_source": { "$ref": "#/$defs/lambda_source" },
        "transport_identity": { "$ref": "#/$defs/transport_identity" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callable", "projections"],
      "properties": {
        "callable": { "$ref": "#/$defs/callable" },
        "projections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/projection" }
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "generated_by", "entries"],
      "properties": {
        "schema_version": { "const": "ores.lambda.callable-registry.v1" },
        "generated_by": { "const": "ores-stack" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    }
  },
  "$ref": "#/$defs/registry"
}
